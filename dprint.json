{
  "lineWidth": 100,
  "json": {
    "trailingCommas": "never"
  },
  "markdown": {
    "textWrap": "always",
    "wrapCodeSpans": false
  },
  "yaml": {
    "proseWrap": "always",
    "quotes": "preferSingle"
  },
  "plugins": [
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ],
  "excludes": [
    "**/*-lock.json",
    "**/testdata/**",
    ".github/.release-please-manifest.json",
    "CHANGELOG.md"
  ]
}
